ADMIN_PASSWORD=Gulf@MarsaAD26
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Registration form email (nodemailer). Required on the live server.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=registrations@marsasaadiyat.ae
SMTP_PASS=
SMTP_FROM=registrations@marsasaadiyat.ae
CONTACT_TO=registrations@marsasaadiyat.ae,julio@gulfestates.ae

# Required on Vercel so /admin can update content/site.json in this repo.
# Create a GitHub fine-grained token with Contents: Read and write.
GITHUB_TOKEN=
# Optional overrides. On Vercel these default to VERCEL_GIT_REPO_OWNER / SLUG / COMMIT_REF.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=main
